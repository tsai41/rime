# ============================================================
# Rime: Ignore all runtime-generated and cache files
# ============================================================

/trash/

# 動態使用者資料庫（LevelDB）
*.userdb/
*.ldb
*.log
*.LOG
*.LOCK
MANIFEST-*
sync/

# 自動生成的表格與索引
/build/
*.table.bin
*.reverse.bin

# 臨時檔、備份檔
*.bak
*.tmp
*.swp
.DS_Store

# 機器特定狀態檔（deploy 時自動生成/更新, 跨機同步會互蓋）
user.yaml
installation.yaml
